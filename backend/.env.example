# Database
DATABASE_URL=postgresql+asyncpg://emailblaster:emailblaster@postgres:5432/emailblaster

# Redis
REDIS_URL=redis://redis:6379/0

# Anthropic
ANTHROPIC_API_KEY=

# Email sending
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Email Blaster

# Enrichment (optional — app degrades gracefully without these)
APOLLO_API_KEY=
HUNTER_API_KEY=

# Credential encryption (REQUIRED — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: if this key is lost, all stored inbox passwords are unrecoverable.)
ENCRYPTION_KEY=

# IMAP polling interval (applies globally across all connected accounts)
IMAP_POLL_INTERVAL_MINUTES=20

# App
SECRET_KEY=dev-secret-change-me
FRONTEND_URL=http://localhost:5173
WEBHOOK_BASE_URL=http://localhost:8000

# --- Agent / notifications ---
# Where agent alerts (positive-reply pings, task reminders, daily digest)
# are emailed.  Empty = notifications persist in the UI but no email.
OWNER_NOTIFY_EMAIL=
OWNER_NOTIFY_NAME=Operator
# FROM address for agent alert emails (verified Brevo sender). Empty = use the campaign Brevo sender.
OWNER_NOTIFY_FROM_EMAIL=
OWNER_NOTIFY_FROM_NAME=
# Master kill-switch for all autonomous agent behaviour.
AGENT_ENABLED=true
# Classification (Haiku, cheap) vs reply drafting (Sonnet, quality).
ANTHROPIC_AGENT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_AGENT_DRAFT_MODEL=claude-sonnet-4-6
AGENT_REMINDER_SWEEP_INTERVAL_MINUTES=30
AGENT_DIGEST_HOUR_UTC=12
AGENT_STALE_OPP_DAYS=7
AGENT_TASK_DUE_SOON_HOURS=24

# --- Deliverability guard ---
SEND_TIME_OPTIMIZATION_DEFAULT=false
DOMAIN_MAX_PER_HOUR=100
DOMAIN_MAX_PER_DAY=500
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_MIN_SAMPLE=20
CIRCUIT_BREAKER_BOUNCE_RATE=0.05
CIRCUIT_BREAKER_SPAM_RATE=0.001
CIRCUIT_BREAKER_WINDOW_HOURS=24
