# Email Blaster — environment template
#
# Copy to `.env` and fill in the REQUIRED values (marked below).  Everything
# else has a working default and is an optional tuning knob.
#
# IMPORTANT (docker workflow): a variable only reaches the containers if it is
# listed in the per-service `environment:` block of docker-compose.yml.  Every
# var in THIS file is already wired there.  If you add a new setting to
# backend/app/config.py, you must ALSO add it to the environment: block of
# backend, worker AND beat — otherwise the code default silently wins.
#
# `docker compose restart` does NOT re-read .env.  After editing, run:
#   docker compose up -d --force-recreate backend worker beat
# and confirm with `docker compose exec worker printenv VAR_NAME`.

# ════════════════════════════════════════════════════════════════════
# MULTI-TENANCY — the variables below (down to "Infrastructure") are
# what a hosted multi-tenant deployment needs.  Full walkthrough:
# docs/deploy.md.  TL;DR per environment:
#
#   Local dev (just you):     SECRET_KEY + ENCRYPTION_KEY.
#   Hosted (real tenants):    + APP_DATABASE_URL (RLS!), PLATFORM_BREVO_*,
#                             SESSION_COOKIE_SECURE=true, STRIPE_*,
#                             SUPERADMIN_EMAILS.
# ════════════════════════════════════════════════════════════════════

# =====================================================================
# 1. Platform secrets — REQUIRED (the app refuses to boot without)
# =====================================================================
# Signs unsubscribe links + app secrets.  Long random string, never the
# dev default.
SECRET_KEY=
# Fernet key encrypting ALL stored secrets at rest (tenant provider keys,
# IMAP passwords).  Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# =====================================================================
# 2. Tenant isolation (RLS) — REQUIRED on any hosted deployment
# =====================================================================
# Non-owner runtime DSN (role app_user, created by
# backend/scripts/bootstrap_db.sql).  Postgres row-level security only
# bites when the app does NOT connect as the table owner — empty falls
# back to DATABASE_URL (owner) and the boot log prints a CRITICAL
# "row-level security is BYPASSED" warning.  Fine for a single-operator
# dev box; never ship real tenants this way.
# e.g. postgresql+asyncpg://app_user:<password>@postgres:5432/emailblaster
APP_DATABASE_URL=

# =====================================================================
# 3. Auth / sessions
# =====================================================================
# Session-cookie lifetime.
SESSION_TTL_DAYS=30
# Set true in production (HTTPS) so the session cookie is Secure.
SESSION_COOKIE_SECURE=false
# Platform transactional email for AUTH MAIL ONLY (password resets, team
# invites).  Deliberately distinct from any tenant's Brevo key — a
# locked-out user can't depend on their own key to reset the password
# that unlocks it.  Empty = reset/invite links are created but no email
# is sent (dev-only convenience).
PLATFORM_BREVO_API_KEY=
PLATFORM_SENDER_EMAIL=
PLATFORM_SENDER_NAME=OutboundOS

# =====================================================================
# 4. Billing / Stripe
# =====================================================================
# Empty = billing disabled (checkout/portal return 400; unbilled tenants
# stay unmetered).  Webhook endpoint: POST /webhooks/stripe — configure
# the events checkout.session.completed, customer.subscription.created/
# updated/deleted, invoice.payment_failed and put the signing secret here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids for the three plans (test-mode ids differ from live).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7

# =====================================================================
# 5. Hardening levers
# =====================================================================
# Comma-separated emails allowed into /admin (tenant list, impersonation,
# plan overrides — every action is audited to admin_audit).
SUPERADMIN_EMAILS=
# Per-tenant API request budget per minute (0 disables; fail-open on
# Redis outages).
API_RATE_LIMIT_PER_MINUTE=600
# Flip true on hosted deployments once every real tenant is on a plan:
# legacy NULL-status tenants are then DENIED spend instead of exempt.
BILLING_REQUIRE_SUBSCRIPTION=false
# Retired Fernet keys (comma-separated) accepted for DECRYPTION during a
# key rotation — see backend/app/services/encryption.py for the runbook.
ENCRYPTION_KEYS_OLD=

# =====================================================================
# 6. Provider keys — BYOK (tenants bring their own since Phase 4)
# =====================================================================
# Anthropic/Brevo/Apollo/Hunter/Unipile keys are PER-TENANT rows now,
# entered in Settings → Integrations and stored encrypted.  Env values
# here (and in the per-provider sections further down) serve only:
#   (a) the one-time seed for the oldest tenant when migration 0047 runs,
#   (b) the fallback for the deliberately tenant-blind paths.
# A hosted platform normally leaves them EMPTY — the app boots fine.
# Anthropic API key (compose, research, agent, discovery all use it).
ANTHROPIC_API_KEY=
# Brevo transactional API key + a VERIFIED sender address.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# =====================================================================
# Infrastructure (Postgres / frontend)
# =====================================================================
# docker-compose builds DATABASE_URL + REDIS_URL from these; the Postgres
# container is created with them.  Override the password for anything shared.
POSTGRES_USER=emailblaster
POSTGRES_PASSWORD=emailblaster
POSTGRES_DB=emailblaster
# Only needed when running OUTSIDE docker (compose sets these itself):
# DATABASE_URL=postgresql+asyncpg://emailblaster:emailblaster@localhost:5432/emailblaster
# REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
# Public base URL the backend builds webhook callbacks from (set to your
# ngrok/cloudflared tunnel host when wiring Unipile/Brevo webhooks).
WEBHOOK_BASE_URL=http://localhost:8000
# Where the frontend points its API calls (build-time).
VITE_API_BASE_URL=http://localhost:8000

# =====================================================================
# Email sending (Brevo)
# =====================================================================
BREVO_SENDER_NAME=Email Blaster
# false mirrors "Click tracking" OFF in Brevo; the app then reports click-rate
# as "not tracked" instead of a misleading 0%.  Open tracking is unaffected.
EMAIL_CLICK_TRACKING_ENABLED=true
# Poll cadence (minutes) for Brevo's transactional events API.
BREVO_EVENTS_POLL_INTERVAL_MINUTES=10
# How often (minutes) to sync Brevo's blocked-contacts list into suppression.
BREVO_BLOCKLIST_SYNC_INTERVAL_MINUTES=360
# Suppress an address after this many soft bounces (0 = never).
SOFT_BOUNCE_SUPPRESS_THRESHOLD=1
# Brevo outbound webhook auth (optional real-time events on top of polling).
# Set the secret to a random value AND add it as the X-Brevo-Auth header on the
# webhook in Brevo.  Empty secret → the /webhooks/brevo route rejects everything.
BREVO_WEBHOOK_SECRET=
BREVO_WEBHOOK_AUTH_HEADER=X-Brevo-Auth

# =====================================================================
# Anthropic models + research cost levers
# =====================================================================
# Compose writes the email copy — keep on Sonnet for quality.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Research is extraction-from-search-results — Haiku is ~3.75x cheaper.
ANTHROPIC_RESEARCH_MODEL=claude-haiku-4-5-20251001
# Web searches per lead's research call — the single biggest cost lever.
# 1 = one focused search/lead; bump to 2-3 for marginal extra signal at +cost.
RESEARCH_WEB_SEARCH_MAX_USES=1
# Days a cached research_data row stays fresh (cross-campaign / research-client).
RESEARCH_CACHE_TTL_DAYS=90
# Research-a-client (one-off LinkedIn URL → outreach).
ANTHROPIC_RESEARCH_CLIENT_MODEL=claude-haiku-4-5-20251001
RESEARCH_CLIENT_FAST_WEB_SEARCH_MAX_USES=2
RESEARCH_CLIENT_DEEP_WEB_SEARCH_MAX_USES=5
# Social Listening Radar discovery.
ANTHROPIC_SOCIAL_DISCOVERY_MODEL=claude-haiku-4-5-20251001
SOCIAL_DISCOVERY_WEB_SEARCH_MAX_USES=3
# LinkedIn discovery is poorly indexed — Sonnet + a bigger budget help recall.
LINKEDIN_DISCOVERY_MODEL=claude-sonnet-4-6
LINKEDIN_DISCOVERY_WEB_SEARCH_MAX_USES=5

# =====================================================================
# Enrichment (optional — features no-op without a key)
# =====================================================================
APOLLO_API_KEY=
HUNTER_API_KEY=
# Hunter Domain Search cap — free plan rejects > 10; raise on a paid plan.
HUNTER_DOMAIN_SEARCH_LIMIT=10

# =====================================================================
# Unipile (hosted LinkedIn browser API) — required only for LinkedIn steps
# =====================================================================
# DSN is the tenant host from the dashboard, e.g. api12.unipile.com:13443
UNIPILE_DSN=
UNIPILE_API_KEY=
# Static shared-secret header Unipile echoes on every webhook delivery.
UNIPILE_WEBHOOK_SECRET=
UNIPILE_WEBHOOK_AUTH_HEADER=X-Unipile-Auth

# =====================================================================
# LinkedIn rate limits (per Unipile account)
# =====================================================================
LINKEDIN_DAILY_ACTION_CAP=20
LINKEDIN_MIN_ACTION_DELAY_SECONDS=30
# Scheduler releases at most one LinkedIn step per account per N seconds
# (0 disables staggering, falling back to the min-delay floor).
LINKEDIN_STAGGER_SECONDS=120
LINKEDIN_POLL_INTERVAL_MINUTES=30
LINKEDIN_DAILY_CONNECT_CAP=20
LINKEDIN_DAILY_DM_CAP=30
LINKEDIN_MONTHLY_PAGE_INVITE_CAP=250

# =====================================================================
# Deliverability guard
# =====================================================================
# Default send-time-optimization toggle for new campaigns.
SEND_TIME_OPTIMIZATION_DEFAULT=false
# Per-SENDING-DOMAIN caps shared across all campaigns on that domain.
DOMAIN_MAX_PER_HOUR=100
DOMAIN_MAX_PER_DAY=500
# Bounce/spam circuit breaker (auto-pauses a campaign; never auto-resumes).
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_MIN_SAMPLE=20
CIRCUIT_BREAKER_BOUNCE_RATE=0.05
CIRCUIT_BREAKER_SPAM_RATE=0.001
CIRCUIT_BREAKER_WINDOW_HOURS=24

# =====================================================================
# CRM / inbox agent + notifications
# =====================================================================
# Where agent alerts are emailed.  Empty = notifications persist in-app only.
OWNER_NOTIFY_EMAIL=
OWNER_NOTIFY_NAME=Operator
# FROM address for agent alert emails (must be a verified Brevo sender).
# Empty → falls back to the campaign Brevo sender.
OWNER_NOTIFY_FROM_EMAIL=
OWNER_NOTIFY_FROM_NAME=
# Hard kill-switch for ALL autonomous agent behaviour (wins over DB toggles).
AGENT_ENABLED=true
# Reply classification (cheap, per-reply) vs reply DRAFTS (Sonnet quality).
ANTHROPIC_AGENT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_AGENT_DRAFT_MODEL=claude-sonnet-4-6
AGENT_REMINDER_SWEEP_INTERVAL_MINUTES=30
AGENT_DIGEST_HOUR_UTC=12
AGENT_STALE_OPP_DAYS=7
AGENT_TASK_DUE_SOON_HOURS=24

# =====================================================================
# Mail polling
# =====================================================================
IMAP_POLL_INTERVAL_MINUTES=20

# =====================================================================
# Nonprofit funding discovery (feeds the prospect_signals queue)
# =====================================================================
# Each feed no-ops while disabled.  Discovered orgs are notification-only
# unless HUNTER_API_KEY is set (needed to resolve contacts).
USASPENDING_ENABLED=false
USASPENDING_LOOKBACK_DAYS=30
USASPENDING_MAX_AWARD_AMOUNT=500000
IRS_BMF_ENABLED=false
# Comma-separated states, e.g. PA,NJ,NY (empty = skip the IRS feed).
IRS_BMF_STATES=
IRS_BMF_RULING_LOOKBACK_MONTHS=2
# Contact enrichment for discovered orgs (Anthropic + Hunter cost per org).
FUNDING_DISCOVERY_MAX_PER_RUN=25
FUNDING_SCRAPE_MAX_PAGES=6
FUNDING_ENRICHMENT_MAX_ATTEMPTS=3
FUNDING_ENRICHMENT_BATCH=25
# Fall back to a "Direct mail" CRM task for exhausted orgs with a mailing addr.
FUNDING_DIRECT_MAIL_FALLBACK=false

# =====================================================================
# Signals & Intent Engine v2 (Adzuna dev-role feed)
# =====================================================================
# Adzuna job-aggregator API (free tier: https://developer.adzuna.com).
# No key → the dev-role collector no-ops.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
